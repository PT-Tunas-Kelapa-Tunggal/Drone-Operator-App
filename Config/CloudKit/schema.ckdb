DEFINE SCHEMA

    CREATE ROLE "Drone Operator";

    RECORD TYPE PlantationScanRequest (
        "___createTime"              TIMESTAMP SORTABLE,
        "___createdBy"               REFERENCE,
        "___etag"                    STRING,
        "___modTime"                 TIMESTAMP,
        "___modifiedBy"              REFERENCE,
        "___recordID"                REFERENCE QUERYABLE,
        averageHarvestWeightKg       DOUBLE QUERYABLE SORTABLE,
        farmAddress                  STRING QUERYABLE SEARCHABLE SORTABLE,
        farmBoundary                 LIST<LOCATION> QUERYABLE,
        farmCircumference            DOUBLE QUERYABLE SORTABLE,
        farmName                     STRING QUERYABLE SEARCHABLE SORTABLE,
        farmNutrientComparisonStatus STRING QUERYABLE SEARCHABLE SORTABLE,
        farmSize                     DOUBLE QUERYABLE SORTABLE,
        farmerContactName            STRING QUERYABLE SEARCHABLE SORTABLE,
        farmerHomeAddress            STRING QUERYABLE SEARCHABLE SORTABLE,
        farmerPhoneNumber            STRING QUERYABLE SEARCHABLE SORTABLE,
        fertilizationBudgetPerHa     INT64 QUERYABLE SORTABLE,
        fertilizationScheduling      STRING QUERYABLE SEARCHABLE SORTABLE,
        fertilizerNeedPerZone        STRING QUERYABLE SEARCHABLE SORTABLE,
        fertilizer_cost_predictions  STRING QUERYABLE SEARCHABLE SORTABLE,
        fertilizersCompositions      STRING QUERYABLE SEARCHABLE SORTABLE,
        fertilizingFrequencyPerYear  INT64 QUERYABLE SORTABLE,
        fertilizingZone              STRING QUERYABLE SEARCHABLE SORTABLE,
        harvestFrequencyPerMonth     INT64 QUERYABLE SORTABLE,
        orthomosaicImage             ASSET,
        plantingMonthAndYear         TIMESTAMP QUERYABLE SORTABLE,
        progressionStatus            STRING QUERYABLE SEARCHABLE SORTABLE,
        progressionStatusDetail      STRING QUERYABLE SEARCHABLE SORTABLE,
        resultSentAt                 TIMESTAMP QUERYABLE SORTABLE,
        schemaVersion                INT64 QUERYABLE SORTABLE,
        soilType                     STRING QUERYABLE SEARCHABLE SORTABLE,
        submittedAt                  TIMESTAMP QUERYABLE SORTABLE,
        treeIdentification           STRING QUERYABLE SEARCHABLE SORTABLE,
        variPlainZoneOverlayImage    ASSET,
        variTreeQuartileOverlayImage ASSET,
        GRANT READ, WRITE TO "Drone Operator",
        GRANT READ, WRITE TO "_creator",
        GRANT CREATE TO "_icloud"
    );

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator"
    );
